  <ItemGroup>
    <ProjectReference Include="..\SecretHive.Domain\SecretHive.Domain.csproj" />
    <ProjectReference Include="..\SecretHive.Application\SecretHive.Application.csproj" />
  </ItemGroup>
</Project>
