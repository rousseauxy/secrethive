@page "/vaults/{Vault}/secrets/{Name}"
@layout VaultLayout
@inject Vaults Vaults
@inject NavigationManager Navigation

<PageTitle>@Name · SecretHive</PageTitle>

<div class="sh-page-head">
    <div>
        <p class="sh-crumbs"><a href="/">Vaults</a> <span class="sh-crumb-sep">/</span> <a href="@($"/vaults/{Vault}")">@Vault</a> <span class="sh-crumb-sep">/</span> <span>@Name</span></p>
        <div class="sh-title-row"><h1 class="sh-mono">@Name</h1>@if (secret is not null) { <PinButton @key="@($"{Vault}/{Name}")" Vault="@Vault" Secret="@Name" Pinned="pinned" /> }</div>
    </div>
    @if (secret is not null)
    {
        <div class="sh-right">
            <span class="sh-badge">@(secret.Kind == ValueKind.Certificate ? "certificate" : "secret")</span>
            <span class="sh-badge">version @secret.Version</span>
            @if (secret.IsLinked)
            {
                <span class="sh-badge sh-badge-accent">linked</span>
            }
            @if (role is not null)
            {
                <span class="sh-badge" title="Your role in this vault">@SecretService.RoleName(role.Value)</span>
            }
        </div>
    }
</div>

@if (secret is not null && (canSet || CanChange))
{
    @* What can be done to it, all in one row and each in a dialog; what this caller may not do is not offered. *@
    <div class="sh-action-bar">
        @if (canSet)
        {
            <button class="sh-btn" @onclick="() => Open(SecretAction.NewVersion)"><Icon Name="@(secret.Kind == ValueKind.Certificate ? "certificate" : "refresh")" /> @(secret.Kind == ValueKind.Certificate ? "Renew…" : "New version…")</button>
        }
        @if (CanChange)
        {
            <button class="sh-btn" @onclick="() => Open(SecretAction.Rename)">Rename…</button>
            <button class="sh-btn" @onclick="() => Open(SecretAction.Elsewhere)">Link, copy or move…</button>
            @if (secret.LinkedWith is { Count: > 0 })
            {
                <button class="sh-btn" @onclick="() => Open(SecretAction.Unlink)">Unlink…</button>
            }
            <button class="sh-btn sh-btn-danger" @onclick="() => Open(SecretAction.Delete)"><Icon Name="trash" /> Delete…</button>
        }
    </div>
}

<SecretActions @ref="actions" Vault="@Vault" OnDone="Done" />

<Problem Message="@problem" />
@if (done is not null)
{
    <div class="sh-done" role="status">@done</div>
}

@if (secret is not null)
{
    @if (secret.Kind == ValueKind.Secret)
    {
        <div class="sh-card">
            <div class="sh-card-header"><h2>Value</h2><span class="sh-muted sh-small">Revealing or copying is recorded in the audit trail.</span></div>
            <div class="sh-card-body">
                <SecretValues Secret="secret" Read="ReadText" />
            </div>
        </div>
    }
    else if (secret.Certificate is not null)
    {
        <div class="sh-card">
            <div class="sh-card-header"><h2>Certificate</h2></div>
            <div class="sh-card-body">
                <CertificateDetails Vault="@Vault" Secret="secret" Read="ReadText" />
            </div>
        </div>
    }

    <div class="sh-card">
        <div class="sh-card-header">
            <h2>Details</h2>
            @if (CanChange)
            {
                <div class="sh-right"><button class="sh-btn sh-btn-sm" @onclick="() => editing = !editing">@(editing ? "Cancel" : "Edit")</button></div>
            }
        </div>
        <div class="sh-card-body">
            @if (!editing)
            {
                <SecretFacts Secret="secret" />
            }
            else
            {
                <form class="sh-form" @onsubmit="SaveDetails">
                    <div class="sh-field">
                        <label class="sh-label">Description</label>
                        <input class="sh-input" @bind="description" />
                        @if (secret.IsLinked)
                        {
                            <span class="sh-hint">This name's own: the other names of this value keep theirs.</span>
                        }
                    </div>
                    <div class="sh-field">
                        <label class="sh-label">Fields</label>
                        <FieldEditor Rows="details" AllowSensitive="false" Standard="true" />
                        <span class="sh-hint">These are readable columns. A sensitive field belongs to a version: add it with a new version.@(secret.IsLinked ? " The fields belong to the value: every linked name gets what is saved here." : "")</span>
                    </div>
                    <div class="sh-form-actions"><button class="sh-btn sh-btn-primary" type="submit">Save details</button></div>
                </form>
            }
        </div>
    </div>

    <div class="sh-card">
        <div class="sh-card-header">
            <h2>Versions</h2>
            <span class="sh-muted sh-small">Every change makes a new version; the earlier ones are kept. The description and ordinary fields are not part of a version.</span>
        </div>
        <div class="sh-table-wrap">
            <table class="sh-table">
                <thead><tr><th>Version</th><th>Made (UTC)</th><th>By</th><th>Holds</th><th></th></tr></thead>
                <tbody>
                    @foreach (var version in versions)
                    {
                        <tr>
                            <td class="sh-nowrap">
                                @version.Number
                                @if (version.Current)
                                {
                                    <span class="sh-badge sh-badge-accent">current</span>
                                }
                            </td>
                            <td class="sh-nowrap sh-muted">@version.CreatedUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                            <td>@version.CreatedBy</td>
                            <td class="sh-small">
                                @if (version.CertificateNotAfterUtc is { } until)
                                {
                                    <span>certificate until @until.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                                }
                                else
                                {
                                    <span>@string.Join(", ", version.Slots.Select(SlotName))</span>
                                }
                            </td>
                            <td>
                                @if (!version.Current)
                                {
                                    @if (CanRead && version.Slots.Contains(SecretService.ValueSlot))
                                    {
                                        <RevealBox @key="@($"old-{version.Id}")" Read="@(() => ReadText(SecretService.ValueSlot, version.Number))" />
                                    }
                                    @if (CanChange)
                                    {
                                        @if (goingBackTo == version.Number)
                                        {
                                            <button class="sh-btn sh-btn-sm sh-btn-primary" @onclick="() => GoBack(version.Number)">Make version @version.Number current again</button>
                                            <button class="sh-btn sh-btn-sm" @onclick="() => goingBackTo = null">Cancel</button>
                                        }
                                        else
                                        {
                                            <button class="sh-btn sh-btn-sm" @onclick="() => goingBackTo = version.Number">Go back to this…</button>
                                        }
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (goingBackTo is not null)
        {
            <div class="sh-card-body">
                <p class="sh-muted" style="margin: 0">
                    Going back makes a new version that holds what that one held. Nothing is lost: what is current now
                    stays in the list. @(secret.LinkedWith is { Count: > 0 } ? "This secret is linked into other vaults; they follow." : "")
                    Whatever reads this secret gets the earlier content from its next fetch on.
                </p>
            </div>
        }
    </div>

    @if (CanChange || Vaults.IsAdmin)
    {
    <div class="sh-card">
        <div class="sh-card-header">
            <h2>Activity</h2>
            <span class="sh-muted sh-small">Every reveal, copy and change of this secret under this name, newest first.</span>
        </div>
        <AuditTable Rows="activity" ShowVault="false" ShowSecret="false" />
    </div>
    }

}

@code {
    private SecretSummary? secret;
    private VaultRole? role;

    private bool canSet;

    private bool CanChange => role >= VaultRole.SecretsOfficer;
    private bool CanRead => role >= VaultRole.SecretsUser;
    private IReadOnlyList<VersionInfo> versions = [];
    private int? goingBackTo;
    private IReadOnlyList<AuditEvent> activity = [];
    private string? problem;
    private string? done;
    private bool pinned;
    private SecretActions actions = default!;

    private bool editing;
    private string? description;
    private List<FieldRow> details = [];

    [Parameter]
    public string Vault { get; set; } = "";

    [Parameter]
    public string Name { get; set; } = "";

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        try
        {
            role = await Vaults.Run(service => service.RoleAsync(Vault, Vaults.Caller));
            canSet = await Vaults.Run(service => service.CanSetAsync(Vault, Vaults.Caller));
            secret = (await Vaults.Run(service => service.ListAsync(Vault, Vaults.Caller))).FirstOrDefault(item => string.Equals(item.Name, Name, StringComparison.OrdinalIgnoreCase));
            activity = CanChange || Vaults.IsAdmin ? await Vaults.Run(service => service.AuditAsync(25, Vaults.Caller, Vault, Name)) : [];
            versions = secret is null ? [] : await Vaults.Run(service => service.ListVersionsAsync(Vault, Name, Vaults.Caller));
            goingBackTo = null;
        }
        catch (DomainException e)
        {
            problem = e.Message;
            return;
        }

        if (secret is null)
        {
            problem = $"There is no secret '{Name}' in '{Vault}'.";
            return;
        }

        pinned = await Vaults.Run(service => service.IsPinnedAsync(Vault, Name, Vaults.Caller));
        description = secret.Description;
        details = [.. secret.Fields.Select(field => new FieldRow { Name = field.Key, Value = field.Value, Type = TypeOf(field.Key) })];
        editing = false;
    }

    // The listing gives ordinary fields as text; the reserved ones have a fixed type, the rest are kept as text.
    private static FieldType TypeOf(string name) => name == "url" ? FieldType.Url : FieldType.Text;

    private static string SlotName(string slot) =>
        slot == SecretService.ValueSlot ? "the value" : slot.StartsWith("field:", StringComparison.Ordinal) ? slot[6..] + " (sensitive)" : slot.StartsWith("part:", StringComparison.Ordinal) ? slot[5..] : slot;

    private async Task GoBack(int number)
    {
        problem = await Vaults.Try(service => service.RestoreVersionAsync(Vault, Name, number, Vaults.Caller));
        var said = problem;
        await Load();
        problem = said ?? problem;
    }

    private Task<string> ReadText(string slot) => ReadText(slot, null);

    private async Task<string> ReadText(string slot, int? number)
    {
        using var value = await Vaults.Run(service => service.ReadAsync(Vault, Name, Vaults.Caller, slot, number));

        // The read just made is on record; show it, so the page says what it did.
        if (CanChange || Vaults.IsAdmin)
        {
            activity = await Vaults.Run(service => service.AuditAsync(25, Vaults.Caller, Vault, Name));
            StateHasChanged();
        }
        return Encoding.UTF8.GetString(value.Reveal());
    }

    private async Task Act(Func<SecretService, Task> act, string? goTo = null)
    {
        problem = await Vaults.Try(act);
        if (problem is not null)
        {
            return;
        }

        if (goTo is not null)
        {
            Navigation.NavigateTo(goTo);
        }
        else
        {
            await Load();
        }
    }

    private Task SaveDetails() => Act(service => service.UpdateDetailsAsync(Vault, Name, description, FieldRow.Inputs(details), Vaults.Caller));

    private Task Open(SecretAction action)
    {
        done = null;
        return actions.Open(action, secret!);
    }

    // A rename or a move goes to where the secret is now, a delete to its vault; the rest stay here, read again.
    private async Task Done(SecretActionResult result)
    {
        done = result.Message;
        if (result.Location is { } location)
        {
            Navigation.NavigateTo(location);
        }
        else
        {
            await Load();
        }
    }
}
