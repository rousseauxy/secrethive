@page "/account/password"
@layout PlainLayout
@attribute [ExcludeFromInteractiveRouting]
@using SecretHive.Application.Accounts
@using SecretHive.Application.Ports
@inject AccountService Accounts
@inject IUserStore Users
@inject AuditWriter Audit
@inject NavigationManager Navigation

<PageTitle>Password · SecretHive</PageTitle>

<div class="sh-signin">
    <div class="sh-card">
        <div class="sh-card-header"><h2>Choose a new password</h2></div>
        <div class="sh-card-body">
            @if (forced)
            {
                <div class="sh-note">The password you signed in with was set by someone else. Choose your own before anything else.</div>
            }
            <Problem Message="@problem" />
            <form class="sh-form" method="post" @formname="password" @onsubmit="Change">
                <AntiforgeryToken />
                <div class="sh-field">
                    <label class="sh-label" for="current">Current password</label>
                    <input class="sh-input" id="current" name="Current" type="password" autocomplete="current-password" autofocus />
                </div>
                <div class="sh-field">
                    <label class="sh-label" for="new">New password</label>
                    <input class="sh-input" id="new" name="New" type="password" autocomplete="new-password" />
                    <span class="sh-hint">At least @AccountService.MinimumPasswordLength characters. Length matters; there are no other rules.</span>
                </div>
                <div class="sh-field">
                    <label class="sh-label" for="again">New password, again</label>
                    <input class="sh-input" id="again" name="Again" type="password" autocomplete="new-password" />
                </div>
                <div class="sh-form-actions">
                    <button class="sh-btn sh-btn-primary" type="submit">Change password</button>
                    @if (!forced)
                    {
                        <a class="sh-btn" href="/account/profile">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@code {
    private string? problem;
    private bool forced;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private string? Current { get; set; }

    [SupplyParameterFromForm]
    private string? New { get; set; }

    [SupplyParameterFromForm]
    private string? Again { get; set; }

    protected override void OnInitialized() => forced = HttpContext.Items.ContainsKey(Security.Accounts.MustChangePasswordItem);

    private async Task Change()
    {
        if (Security.Accounts.Actor(HttpContext.User) is not { } actor)
        {
            problem = "This session is not an account with a password.";
            return;
        }

        if (New != Again)
        {
            problem = "The two new passwords are not the same.";
            return;
        }

        var outcome = await Accounts.ChangeOwnPasswordAsync(actor.Key, Current ?? "", New ?? "", HttpContext.RequestAborted);
        problem = outcome switch
        {
            AccountOutcome.Done => null,
            AccountOutcome.WrongPassword => "The current password is not right.",
            AccountOutcome.PasswordTooShort => $"The new password must be at least {AccountService.MinimumPasswordLength} characters, and not the current one.",
            _ => "This account has no password to change.",
        };
        if (problem is not null)
        {
            return;
        }

        // The change ended every session of this account, this one included; sign this browser in again.
        var user = await Users.FindAsync(actor.Key, HttpContext.RequestAborted);
        await Security.Accounts.SignInUserAsync(HttpContext, user!);
        await Audit.RecordAsync("auth.password.changed", new Caller(user!.UserName, HttpContext.Connection.RemoteIpAddress?.ToString(), "ui"));
        Navigation.NavigateTo("/");
    }
}
