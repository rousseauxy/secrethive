@page "/vaults/{Vault}"
@layout VaultLayout
@inject Vaults Vaults
@inject NavigationManager Navigation

<PageTitle>@Vault · SecretHive</PageTitle>

<VaultHeader Vault="@Vault" Role="role" CanManage="canManage" Active="secrets">
    @if (canSet)
    {
        <button class="sh-btn sh-btn-primary" @onclick="OpenSecret"><Icon Name="plus" /> New secret</button>
        <button class="sh-btn" @onclick="OpenCertificate"><Icon Name="certificate" /> New certificate</button>
    }
</VaultHeader>

<Problem Message="@problem" />
@if (done is not null)
{
    <div class="sh-done" role="status">@done</div>
}

<SecretActions @ref="actions" Vault="@Vault" OnDone="Done" />
<BulkActions @ref="bulk" Vault="@Vault" OnDone="BulkDone" />

@if (secrets.Count > 0 || filter.Length > 0)
{
    <SecretSearch @key="Vault" Vault="@Vault" OnSearching="shown => searchingAll = shown" OnFilter="text => filter = text" />
}

@if (!searchingAll)
{

@* The list, and beside it the secret chosen in the address (?secret=name). On a phone the panel takes the place of
   the list until it is closed. *@
<div class="sh-split @(Shown is not null ? "has-panel" : "")">
<div class="sh-split-list">
<div class="sh-card">
    @if (CanChange && chosen.Count > 0)
    {
        @* What was chosen in the list, and what can be done to all of it at once. *@
        <div class="sh-bulkbar" role="toolbar" aria-label="Chosen secrets">
            <span><b>@chosen.Count</b> chosen</span>
            <button class="sh-btn sh-btn-sm" @onclick="() => OpenBulk(BulkAction.Elsewhere)">Link, copy or move…</button>
            <button class="sh-btn sh-btn-sm sh-btn-danger" @onclick="() => OpenBulk(BulkAction.Delete)"><Icon Name="trash" /> Delete…</button>
            <button class="sh-btn sh-btn-sm" @onclick="() => chosen.Clear()">Clear</button>
        </div>
    }
    @if (secrets.Count == 0)
    {
        <div class="sh-empty">@(problem is null ? "This vault is empty." : "Nothing to show.")</div>
    }
    else if (Listed.Count == 0)
    {
        <div class="sh-empty">Nothing in @Vault matches "@filter". A search looks at names, descriptions and ordinary fields, never at values.</div>
    }
    else
    {
        <table class="sh-table">
            <thead>
                <tr>
                    @if (CanChange)
                    {
                        <th class="sh-col-check">
                            <input type="checkbox" title="Choose every secret shown" aria-label="Choose every secret shown"
                                   checked="@(Listed.All(secret => chosen.Contains(secret.Name)))" @onchange="e => ChooseAll((bool)e.Value!)" />
                        </th>
                    }
                    <th>Name</th>
                    @if (hasUsername)
                    {
                        <th>Username</th>
                    }
                    <th>Kind</th><th class="sh-col-extra">Version</th><th class="sh-col-fields">Fields</th><th class="sh-col-extra">Changed</th><th><span class="sh-sr">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var secret in Listed)
                {
                    var selected = string.Equals(secret.Name, Shown?.Name, StringComparison.Ordinal);
                    <tr class="@(selected ? "sh-selected" : "")" aria-selected="@(selected ? "true" : null)">
                        @if (CanChange)
                        {
                            <td class="sh-col-check">
                                <input type="checkbox" aria-label="@($"Choose {secret.Name}")" checked="@chosen.Contains(secret.Name)" @onchange="e => Choose(secret.Name, (bool)e.Value!)" />
                            </td>
                        }
                        <td>
                            <a class="sh-mono" href="@SelectHref(secret.Name)" data-select>@secret.Name</a>
                            @if (!string.IsNullOrEmpty(secret.Description))
                            {
                                <span class="sh-info" tabindex="0" role="note" title="@secret.Description"><Icon Name="info" /><span class="sh-sr">@secret.Description</span></span>
                            }
                            @if (secret.IsLinked)
                            {
                                <span class="sh-badge sh-badge-accent" title="@string.Join(", ", secret.LinkedWith ?? [])">linked · @((secret.LinkedWith?.Count ?? 0) + secret.LinkedElsewhere)</span>
                            }
                        </td>
                        @if (hasUsername)
                        {
                            <td class="sh-small">
                                @if (secret.Fields.TryGetValue("username", out var username))
                                {
                                    <span>@username</span>
                                    <CopyButton Title="Copy the username" Text="@(() => Task.FromResult<string?>(username))" />
                                }
                                else if (secret.SensitiveFields.Contains("username"))
                                {
                                    <span class="sh-faint">hidden</span>
                                    @if (CanRead)
                                    {
                                        <CopyButton Title="Copy the username (recorded)" Text="@(() => ReadText(secret.Name, "field:username"))" />
                                    }
                                }
                            </td>
                        }
                        <td>
                            @if (secret.Certificate is { } certificate)
                            {
                                <span class="@ExpiryBadge(certificate.NotAfterUtc)">certificate · @certificate.NotAfterUtc.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                            }
                            else
                            {
                                <span class="sh-badge">secret</span>
                            }
                        </td>
                        <td class="sh-mono sh-col-extra">@secret.Version</td>
                        <td class="sh-small sh-col-fields">
                            @* The username has a column of its own. The lines are one block, so a narrow screen puts them under
                               each other beside the column's name; with no fields there is no block and the cell stays empty. *@
                            @{
                                var plain = secret.Fields.Where(field => field.Key != "username").ToList();
                                var hidden = secret.SensitiveFields.Where(field => field != "username").ToList();
                            }
                            @if (plain.Count + hidden.Count > 0)
                            {
                                <div class="sh-field-lines">
                                    @foreach (var field in plain)
                                    {
                                        <div>
                                            <span class="sh-field-text" title="@field.Value"><span class="sh-muted sh-mono">@field.Key</span> @field.Value</span>
                                            <CopyButton Title="@($"Copy {field.Key}")" Text="@(() => Task.FromResult<string?>(field.Value))" />
                                        </div>
                                    }
                                    @foreach (var field in hidden)
                                    {
                                        <div>
                                            <span class="sh-field-text"><span class="sh-muted sh-mono">@field</span> <span class="sh-faint">hidden</span></span>
                                            @if (CanRead)
                                            {
                                                <CopyButton Title="@($"Copy {field} (recorded)")" Text="@(() => ReadText(secret.Name, $"field:{field}"))" />
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </td>
                        <td class="sh-muted sh-nowrap sh-col-extra">@secret.VersionCreatedUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                        <td class="sh-actions">
                            @* The few things done most, without opening the secret. Copying the value is a read like a reveal, and
                               on record; the rest open the same dialogs as on the secret's own page. *@
                            @if (CanRead && secret.Kind == ValueKind.Secret)
                            {
                                <CopyButton Title="Copy the value (recorded)" Text="@(() => ReadText(secret.Name, SecretService.ValueSlot))" />
                            }
                            @if (canSet)
                            {
                                <button class="sh-btn sh-btn-icon sh-btn-sm" title="@(secret.Kind == ValueKind.Certificate ? "Renew" : "Change value")" @onclick="() => Open(SecretAction.NewVersion, secret)">
                                    <Icon Name="@(secret.Kind == ValueKind.Certificate ? "certificate" : "pencil")" /><span class="sh-sr">@(secret.Kind == ValueKind.Certificate ? "Renew" : "Change value")</span>
                                </button>
                            }
                            @if (CanChange)
                            {
                                @* A <details>, as the menu in the top bar: app.js closes it on a click anywhere else, on one of
                                   its own buttons and on Escape, in the browser, without asking the server. *@
                                <details class="sh-rowmenu" data-menu>
                                    <summary class="sh-btn sh-btn-icon sh-btn-sm" title="More"><Icon Name="more" /><span class="sh-sr">More actions for @secret.Name</span></summary>
                                    <div class="sh-rowmenu-panel" role="menu">
                                        <button type="button" role="menuitem" @onclick="() => Open(SecretAction.Rename, secret)">Rename…</button>
                                        <button type="button" role="menuitem" @onclick="() => Open(SecretAction.Elsewhere, secret)">Link, copy or move…</button>
                                        @if (secret.LinkedWith is { Count: > 0 })
                                        {
                                            <button type="button" role="menuitem" @onclick="() => Open(SecretAction.Unlink, secret)">Unlink…</button>
                                        }
                                        <button type="button" role="menuitem" class="sh-rowmenu-danger" @onclick="() => Open(SecretAction.Delete, secret)"><Icon Name="trash" /> Delete…</button>
                                    </div>
                                </details>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (role >= VaultRole.SecretsOfficer || Vaults.IsAdmin)
{
    @* Closed until asked for: the trail is long, and most visits are for the secrets. Read when it is opened. *@
    <details class="sh-card sh-fold" @ontoggle="ToggleActivity">
        <summary class="sh-card-header">
            <h2>Activity</h2>
            <span class="sh-muted sh-small">What happened in this vault, newest first.</span>
        </summary>
        @if (activityOpen)
        {
            <AuditTable Rows="activity" ShowVault="false" />
            <div class="sh-pager">
                <button class="sh-btn sh-btn-sm" disabled="@(activityPage == 0)" @onclick="() => ShowActivity(activityPage - 1)"><Icon Name="left" /> Newer</button>
                <span class="sh-muted sh-small">Page @(activityPage + 1)</span>
                <button class="sh-btn sh-btn-sm" disabled="@(!activityMore)" @onclick="() => ShowActivity(activityPage + 1)">Older <Icon Name="right" /></button>
                <button class="sh-btn sh-btn-sm sh-pager-end" title="Read the trail again" @onclick="() => ShowActivity(0)"><Icon Name="refresh" /> Refresh</button>
            </div>
        }
    </details>
}
</div>

@if (Shown is { } shown)
{
    <SecretPanel @key="shown.Name" Vault="@Vault" Secret="shown" CanRead="CanRead" CanSet="canSet" CanChange="CanChange"
                 ShowActivity="@(CanChange || Vaults.IsAdmin)" OnAction="action => Open(action, shown)" />
}
</div>
}

<Dialog Title="New secret" Open="secretOpen" OnClose="CloseDialogs" Wide="true">
    <Problem Message="@dialogProblem" />
    <form class="sh-form" @onsubmit="CreateSecret">
        <div class="sh-field">
            <label class="sh-label">Name</label>
            <input class="sh-input sh-mono" @bind="name" placeholder="sql-app-connection" />
            <span class="sh-hint">For what it is, not for who reads it. Letters, digits and hyphens.</span>
        </div>
        <div class="sh-field">
            <label class="sh-label">Value</label>
            <textarea class="sh-textarea" @bind="value" autocomplete="off" spellcheck="false"></textarea>
            <PasswordGenerator OnGenerated="made => value = made" />
        </div>
        <div class="sh-field">
            <label class="sh-label">Description</label>
            <textarea class="sh-textarea sh-grow-box" rows="1" spellcheck="false" @bind="description"></textarea>
        </div>
        <div class="sh-field">
            <label class="sh-label">Fields</label>
            <FieldEditor Rows="fields" Standard="true" />
        </div>
        <div class="sh-form-actions">
            <button class="sh-btn sh-btn-primary" type="submit">Create secret</button>
            <button class="sh-btn" type="button" @onclick="CloseDialogs">Cancel</button>
        </div>
    </form>
</Dialog>

<Dialog Title="New certificate" Open="certificateOpen" OnClose="CloseDialogs" Wide="true">
    <Problem Message="@dialogProblem" />
    <form class="sh-form" @onsubmit="ImportCertificate">
        <div class="sh-field">
            <label class="sh-label">Name</label>
            <input class="sh-input sh-mono" @bind="certificateName" placeholder="wildcard-example-test" />
        </div>
        <CertificateUpload @ref="upload" />
        <div class="sh-field">
            <label class="sh-label">Description</label>
            <textarea class="sh-textarea sh-grow-box" rows="1" spellcheck="false" @bind="certificateDescription"></textarea>
        </div>
        <div class="sh-form-actions">
            <button class="sh-btn sh-btn-primary" type="submit">Store certificate</button>
            <button class="sh-btn" type="button" @onclick="CloseDialogs">Cancel</button>
        </div>
    </form>
</Dialog>

@code {
    private const int ActivityPageSize = 20;

    private IReadOnlyList<SecretSummary> secrets = [];
    private IReadOnlyList<AuditEvent> activity = [];
    private VaultRole? role;
    private bool canManage;
    private bool canSet;
    private string? problem;
    private string? done;
    private SecretActions actions = default!;
    private BulkActions bulk = default!;

    // What the search box narrows the list to, and whether it shows answers from every vault instead of the list.
    private string filter = "";
    private bool searchingAll;

    // The secrets chosen for an action on all of them, by name.
    private readonly HashSet<string> chosen = new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<SecretSummary> Listed => filter.Length == 0 ? secrets : [.. secrets.Where(secret => SecretSearch.Matches(secret, filter))];

    private bool CanChange => role >= VaultRole.SecretsOfficer;
    private bool CanRead => role >= VaultRole.SecretsUser;

    private bool activityOpen;
    private int activityPage;
    private bool activityMore;
    private readonly List<long?> activityCursors = [null];

    private bool secretOpen;
    private bool certificateOpen;
    private string? dialogProblem;

    private string name = "";
    private string value = "";
    private string? description;
    private List<FieldRow> fields = [];

    private string certificateName = "";
    private string? certificateDescription;
    private CertificateUpload upload = default!;

    [Parameter]
    public string Vault { get; set; } = "";

    /// <summary>The secret shown beside the list, by name.</summary>
    [SupplyParameterFromQuery(Name = "secret")]
    public string? Selected { get; set; }

    private string? loadedFor;
    private bool hasUsername;
    private string? actingOn;

    private SecretSummary? Shown => Selected is null ? null : secrets.FirstOrDefault(secret => string.Equals(secret.Name, Selected, StringComparison.OrdinalIgnoreCase));

    private string SelectHref(string name) => $"/vaults/{Vault}?secret={Uri.EscapeDataString(name)}";

    // Choosing another secret changes only the address: the list is read again only for another vault.
    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(loadedFor, Vault, StringComparison.OrdinalIgnoreCase))
        {
            (done, activityOpen, filter, searchingAll) = (null, false, "", false);
            chosen.Clear();
            await Load();
            loadedFor = Vault;
        }
    }

    private async Task Load()
    {
        // Nothing from an earlier look stays on the page when this one is refused.
        secrets = [];
        problem = null;
        try
        {
            // The role and whether the caller manages the vault are known from anywhere, so the way to the access and
            // network pages is still offered when the secrets themselves are refused from this address.
            role = await Vaults.Run(service => service.RoleAsync(Vault, Vaults.Caller));
            canManage = await Vaults.Run(service => service.CanManageAccessAsync(Vault, Vaults.Caller));
            canSet = await Vaults.Run(service => service.CanSetAsync(Vault, Vaults.Caller));
            secrets = await Vaults.Run(service => service.ListAsync(Vault, Vaults.Caller));
            chosen.RemoveWhere(name => !secrets.Any(secret => string.Equals(secret.Name, name, StringComparison.OrdinalIgnoreCase)));
            hasUsername = secrets.Any(secret => secret.Fields.ContainsKey("username") || secret.SensitiveFields.Contains("username"));
        }
        catch (DomainException e)
        {
            problem = e.Message;
        }
    }

    // The fold says when it is opened or closed; it does not say which, so the page keeps count.
    private async Task ToggleActivity()
    {
        activityOpen = !activityOpen;
        if (activityOpen)
        {
            await ShowActivity(0);
        }
    }

    // Each page starts below the last row of the one before (activityCursors), so the trail goes back all the way.
    private async Task ShowActivity(int page)
    {
        try
        {
            if (page == 0)
            {
                activityCursors.RemoveRange(1, activityCursors.Count - 1);
            }
            else if (page > activityPage && activity.Count > 0)
            {
                activityCursors.Add(activity[^1].Id);
            }
            else if (page < activityPage)
            {
                activityCursors.RemoveAt(activityCursors.Count - 1);
            }

            // One more than fits, to know whether there is an older page.
            var rows = await Vaults.Run(service => service.AuditAsync(ActivityPageSize + 1, Vaults.Caller, Vault, before: activityCursors[^1]));
            activity = [.. rows.Take(ActivityPageSize)];
            activityMore = rows.Count > ActivityPageSize;
            activityPage = activityCursors.Count - 1;
        }
        catch (DomainException e)
        {
            problem = e.Message;
        }
    }

    private void OpenSecret()
    {
        (name, value, description, fields, dialogProblem) = ("", "", null, [], null);
        secretOpen = true;
    }

    private void OpenCertificate()
    {
        (certificateName, certificateDescription, dialogProblem) = ("", null, null);
        certificateOpen = true;
    }

    private void CloseDialogs()
    {
        // What was typed does not stay behind in the page: a value is not kept in a closed form.
        (secretOpen, certificateOpen, value, dialogProblem) = (false, false, "", null);
    }

    private async Task CreateSecret()
    {
        dialogProblem = await Vaults.Try(service => service.SetAsync(
            new SetSecret(Vault, name.Trim(), Encoding.UTF8.GetBytes(value), Description: description, Fields: FieldRow.Inputs(fields)),
            Vaults.Caller));
        if (dialogProblem is null)
        {
            Navigation.NavigateTo($"/vaults/{Vault}/secrets/{name.Trim()}");
        }
    }

    private async Task ImportCertificate()
    {
        dialogProblem = await Vaults.Try(service => service.ImportCertificateAsync(
            new ImportCertificate(Vault, certificateName.Trim(), upload.Parts(), certificateDescription),
            Vaults.Caller));
        if (dialogProblem is null)
        {
            Navigation.NavigateTo($"/vaults/{Vault}/secrets/{certificateName.Trim()}");
        }
    }

    private Task Open(SecretAction action, SecretSummary secret)
    {
        (done, actingOn) = (null, secret.Name);
        return actions.Open(action, secret);
    }

    // Whatever was done, the list is read again here: a moved or deleted secret leaves it, a renamed one is in it under
    // its new name. Staying on the list is the point of doing it from here.
    private async Task Done(SecretActionResult result)
    {
        await Load();
        done = result.Message;

        // The panel follows what was done to the secret it shows: a rename keeps it open under the new name, a move
        // or a delete closes it.
        if (Selected is not null && string.Equals(actingOn, Selected, StringComparison.OrdinalIgnoreCase) && result.Location is { } location)
        {
            var here = $"/vaults/{Vault}/secrets/";
            Navigation.NavigateTo(location.StartsWith(here, StringComparison.OrdinalIgnoreCase) ? SelectHref(location[here.Length..]) : $"/vaults/{Vault}");
        }
    }

    private void Choose(string name, bool on)
    {
        if (on)
        {
            chosen.Add(name);
        }
        else
        {
            chosen.Remove(name);
        }
    }

    // Only what the search shows: choosing everything never reaches a secret hidden by the filter.
    private void ChooseAll(bool on)
    {
        foreach (var secret in Listed)
        {
            Choose(secret.Name, on);
        }
    }

    private Task OpenBulk(BulkAction action)
    {
        done = null;
        return bulk.Open(action, [.. secrets.Where(secret => chosen.Contains(secret.Name))]);
    }

    // Whatever went is gone from the list (a delete, a move) or still in it (a link, a copy); the panel of a secret
    // that left is closed.
    private async Task BulkDone(string message)
    {
        await Load();
        done = message;
        if (Selected is not null && Shown is null)
        {
            Navigation.NavigateTo($"/vaults/{Vault}");
        }
    }

    // A copy from the list is a read like any other; what went wrong is said at the top of the list.
    private async Task<string?> ReadText(string secret, string slot)
    {
        try
        {
            using var read = await Vaults.Run(service => service.ReadAsync(Vault, secret, Vaults.Caller, slot));
            return Encoding.UTF8.GetString(read.Reveal());
        }
        catch (DomainException e)
        {
            (problem, done) = (e.Message, null);
            StateHasChanged();
            return null;
        }
    }

    private static string ExpiryBadge(DateTime notAfterUtc) => (notAfterUtc - DateTime.UtcNow).TotalDays switch
    {
        < 3 => "sh-badge sh-badge-danger",
        < 30 => "sh-badge sh-badge-warn",
        _ => "sh-badge sh-badge-ok",
    };
}
