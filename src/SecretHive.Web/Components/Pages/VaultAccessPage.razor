@page "/vaults/{Vault}/access"
@layout VaultLayout
@using SecretHive.Application.Ports
@inject Vaults Vaults

<PageTitle>Access to @Vault · SecretHive</PageTitle>

<VaultHeader Vault="@Vault" Role="role" CanManage="canManage" Active="access" />

<Problem Message="@problem" />
@if (done is not null)
{
    <div class="sh-done" role="status">@done</div>
}

@if (canManage)
{
    <div class="sh-card">
        <div class="sh-card-header">
            <h2>Access</h2>
            <span class="sh-muted sh-small">Who holds which role here. What each role may do is under the list.</span>
        </div>
        <AccessList Entries="accessList" Users="allUsers" Groups="allGroups" Empty="Nobody has a role in this vault yet." LinkFolders="Vaults.IsAdmin"
                    OnGive="Assign" OnRemove="Unassign" OnProblem="said => problem = said">
            <Hint>
                @if (accessList.Any(entry => entry.From is not null))
                {
                    <span>A role <b>from a folder</b> is given on that folder and counts in every vault beneath it; it is changed there. </span>
                }
            </Hint>
        </AccessList>
    </div>
}

@code {
    private IReadOnlyList<AccessEntry> accessList = [];
    private IReadOnlyList<User> allUsers = [];
    private IReadOnlyList<Group> allGroups = [];
    private VaultRole? role;
    private bool canManage;
    private string? problem;
    private string? done;

    [Parameter]
    public string Vault { get; set; } = "";

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        accessList = [];
        try
        {
            // From anywhere: whoever may correct who has access must be able to when the networks are the problem.
            role = await Vaults.Run(service => service.RoleAsync(Vault, Vaults.Caller));
            canManage = await Vaults.Run(service => service.CanManageAccessAsync(Vault, Vaults.Caller));
            if (!canManage)
            {
                problem ??= "Only whoever manages this vault sees who has access to it.";
                return;
            }

            accessList = await Vaults.Run(service => service.ListAccessAsync(Vault, Vaults.Caller));
            allUsers = await Vaults.With<IUserStore, IReadOnlyList<User>>(store => store.ListAsync(default));
            allGroups = await Vaults.With<IAccessStore, IReadOnlyList<Group>>(store => store.ListGroupsAsync(default));
        }
        catch (DomainException e)
        {
            problem = e.Message;
        }
    }

    private async Task Reload(string? said)
    {
        (problem, done) = (null, null);
        await Load();
        problem = said ?? problem;
    }

    private async Task Assign((int? UserKey, int? GroupKey, VaultRole Role) grant) =>
        await Reload(await Vaults.Try(service => service.AssignAsync(Vault, grant.UserKey, grant.GroupKey, grant.Role, Vaults.Caller)));

    private async Task Unassign(AccessEntry entry) =>
        await Reload(await Vaults.Try(service => service.UnassignAsync(Vault, entry.UserKey, entry.GroupKey, Vaults.Caller)));
}
