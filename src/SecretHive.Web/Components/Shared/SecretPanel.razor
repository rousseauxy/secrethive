@inject Vaults Vaults

@* One secret beside its vault's list: what it is, its value, its details and what happened to it lately, with the
   same actions as its own page. Editing details, its versions and its whole history stay on that page. Closing is a
   link back to the list, so it works without a script; app.js follows it on Escape. *@
<aside class="sh-panel" aria-label="@Secret.Name">
    <div class="sh-panel-head">
        <div class="sh-panel-title">
            <div class="sh-title-row"><h2 class="sh-mono">@Secret.Name</h2><PinButton @key="Secret.Name" Vault="@Vault" Secret="@Secret.Name" Pinned="pinned" /></div>
            <div class="sh-panel-badges">
                @if (Secret.Kind == ValueKind.Certificate)
                {
                    <span class="sh-badge">certificate</span>
                }
                else
                {
                    <span class="sh-badge">secret</span>
                }
                <span class="sh-badge">version @Secret.Version</span>
                @if (Secret.IsLinked)
                {
                    <span class="sh-badge sh-badge-accent">linked</span>
                }
            </div>
        </div>
        <a class="sh-btn sh-btn-icon sh-btn-sm" href="@($"/vaults/{Vault}/secrets/{Secret.Name}")" title="Open its page"><Icon Name="open" /><span class="sh-sr">Open its page</span></a>
        <a class="sh-btn sh-btn-icon sh-btn-sm" href="@($"/vaults/{Vault}")" data-panel-close title="Close"><Icon Name="close" /><span class="sh-sr">Close</span></a>
    </div>

    @if (CanSet || CanChange)
    {
        <div class="sh-panel-actions">
            @if (CanSet)
            {
                <button class="sh-btn sh-btn-sm" @onclick="() => OnAction.InvokeAsync(SecretAction.NewVersion)"><Icon Name="@(Secret.Kind == ValueKind.Certificate ? "certificate" : "refresh")" /> @(Secret.Kind == ValueKind.Certificate ? "Renew…" : "New version…")</button>
            }
            @if (CanChange)
            {
                <button class="sh-btn sh-btn-sm" @onclick="() => OnAction.InvokeAsync(SecretAction.Rename)">Rename…</button>
                <button class="sh-btn sh-btn-sm" @onclick="() => OnAction.InvokeAsync(SecretAction.Elsewhere)">Link, copy or move…</button>
                @if (Secret.LinkedWith is { Count: > 0 })
                {
                    <button class="sh-btn sh-btn-sm" @onclick="() => OnAction.InvokeAsync(SecretAction.Unlink)">Unlink…</button>
                }
                <button class="sh-btn sh-btn-sm sh-btn-danger" @onclick="() => OnAction.InvokeAsync(SecretAction.Delete)"><Icon Name="trash" /> Delete…</button>
            }
        </div>
    }

    <Problem Message="@problem" />

    @if (Secret.Kind == ValueKind.Secret)
    {
        <section class="sh-panel-section">
            <h3>Value</h3>
            @if (CanRead)
            {
                <SecretValues Secret="Secret" Read="ReadText" />
                <p class="sh-muted sh-small sh-panel-note">Revealing or copying is recorded in the audit trail.</p>
            }
            else
            {
                <p class="sh-muted sh-small sh-panel-note">Your role in this vault does not read values.</p>
            }
        </section>
    }
    else
    {
        <section class="sh-panel-section">
            <h3>Certificate</h3>
            <CertificateDetails Vault="@Vault" Secret="Secret" Read="ReadText" />
        </section>
    }

    <section class="sh-panel-section">
        <h3>Details</h3>
        <SecretFacts Secret="Secret" />
    </section>

    @if (ShowActivity)
    {
        <section class="sh-panel-section">
            <h3>Activity</h3>
            @if (activity.Count == 0)
            {
                <p class="sh-muted sh-small sh-panel-note">Nothing yet.</p>
            }
            else
            {
                <ul class="sh-panel-activity">
                    @foreach (var row in activity)
                    {
                        <li>
                            <span class="sh-mono">@row.Code</span>
                            @if (row.Severity == AuditSeverity.Security)
                            {
                                <span class="sh-badge sh-badge-danger">security</span>
                            }
                            <span class="sh-muted sh-small">@row.Principal · @row.AtUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</span>
                        </li>
                    }
                </ul>
                <a class="sh-small" href="@($"/vaults/{Vault}/secrets/{Secret.Name}")">All of it on its page</a>
            }
        </section>
    }
</aside>

@code {
    private const int ActivityRows = 10;

    private IReadOnlyList<AuditEvent> activity = [];
    private string? problem;
    private string? shownFor;
    private bool pinned;

    [Parameter, EditorRequired]
    public string Vault { get; set; } = "";

    [Parameter, EditorRequired]
    public SecretSummary Secret { get; set; } = default!;

    [Parameter]
    public bool CanRead { get; set; }

    [Parameter]
    public bool CanSet { get; set; }

    [Parameter]
    public bool CanChange { get; set; }

    /// <summary>The activity is for Secrets Officers and administrators, as on the secret's page.</summary>
    [Parameter]
    public bool ShowActivity { get; set; }

    [Parameter]
    public EventCallback<SecretAction> OnAction { get; set; }

    // Read again when another secret, or another version of this one, is shown.
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Secret.Name}/{Secret.VersionId}";
        if (key != shownFor)
        {
            (shownFor, problem) = (key, null);
            pinned = await Vaults.Run(service => service.IsPinnedAsync(Vault, Secret.Name, Vaults.Caller));
            await ReadActivity();
        }
    }

    private async Task ReadActivity()
    {
        if (!ShowActivity)
        {
            activity = [];
            return;
        }

        try
        {
            activity = await Vaults.Run(service => service.AuditAsync(ActivityRows, Vaults.Caller, Vault, Secret.Name));
        }
        catch (DomainException e)
        {
            problem = e.Message;
        }
    }

    private async Task<string> ReadText(string slot)
    {
        // A refusal reaches the box that asked, which says it; the read that was made is on record and shown here.
        using var value = await Vaults.Run(service => service.ReadAsync(Vault, Secret.Name, Vaults.Caller, slot));
        await ReadActivity();
        StateHasChanged();
        return Encoding.UTF8.GetString(value.Reveal());
    }
}
