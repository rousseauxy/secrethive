@inject Vaults Vaults

@* The search for a secret: on the home page across every vault; on a vault's page this vault by default, or every
   vault when asked. Within this vault it only narrows the list the page already shows (OnFilter), so it reads
   nothing; across every vault it asks the server, and the answers are shown here instead of the page's list. *@
<div class="sh-search @(Vault is null ? "" : "sh-search-scoped")">
    <input class="sh-input" type="search" placeholder="@Placeholder" autocomplete="off" spellcheck="false"
           aria-label="@Placeholder" @bind="query" @bind:event="oninput" @bind:after="Search" />
    @if (Vault is not null)
    {
        <select class="sh-select" aria-label="Where to search" @bind="scope" @bind:after="Search">
            <option value="vault">This vault</option>
            <option value="all">All vaults</option>
        </select>
    }
</div>

@if (searched)
{
    <div class="sh-card">
        @if (found.Count == 0)
        {
            <div class="sh-empty">Nothing in your vaults matches "@query". A search looks at names, descriptions and ordinary fields, never at values.</div>
        }
        else
        {
            <table class="sh-table">
                <thead><tr><th>Secret</th><th>Vault</th><th>Kind</th><th>Fields</th><th>Changed</th></tr></thead>
                <tbody>
                    @foreach (var secret in found)
                    {
                        <tr>
                            <td>
                                <a class="sh-mono" href="@SecretHref(secret.Vault, secret.Name)">@secret.Name</a>
                                @if (!string.IsNullOrEmpty(secret.Description))
                                {
                                    <span class="sh-info" tabindex="0" role="note" title="@secret.Description"><Icon Name="info" /><span class="sh-sr">@secret.Description</span></span>
                                }
                                @if (secret.IsLinked)
                                {
                                    <span class="sh-badge sh-badge-accent" title="@string.Join(", ", secret.LinkedWith ?? [])">linked</span>
                                }
                            </td>
                            <td><a class="sh-mono" href="@($"/vaults/{secret.Vault}")">@secret.Vault</a></td>
                            <td><span class="sh-badge">@(secret.Kind == ValueKind.Certificate ? "certificate" : "secret")</span></td>
                            <td class="sh-small">
                                @foreach (var field in secret.Fields)
                                {
                                    <div><span class="sh-muted sh-mono">@field.Key</span> @field.Value</div>
                                }
                            </td>
                            <td class="sh-muted sh-nowrap">@secret.VersionCreatedUtc.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (found.Count == Limit)
            {
                <div class="sh-card-body sh-muted sh-small">The first @Limit are shown. Type more to narrow it down.</div>
            }
        }
    </div>
}

@code {
    private const int Limit = 50;

    private IReadOnlyList<SecretSummary> found = [];
    private string query = "";
    private string scope = "vault";
    private bool searched;
    private int asked;

    /// <summary>The vault whose page this is; null on the home page, where a search is always across every vault.</summary>
    [Parameter]
    public string? Vault { get; set; }

    /// <summary>Whether answers from every vault are shown here, so the page can hide what they replace.</summary>
    [Parameter]
    public EventCallback<bool> OnSearching { get; set; }

    /// <summary>What to narrow this vault's list to; empty for all of it. Only on a vault's page.</summary>
    [Parameter]
    public EventCallback<string> OnFilter { get; set; }

    private bool Everywhere => Vault is null || scope == "all";

    private string Placeholder => Everywhere
        ? "Search secrets in every vault: a name, a description, a field…"
        : $"Search {Vault}: a name, a description, a field…";

    private static string SecretHref(string vault, string secret) => $"/vaults/{vault}?secret={Uri.EscapeDataString(secret)}";

    /// <summary>Whether a secret holds every word of the query, by the same rules as the search across vaults.</summary>
    public static bool Matches(SecretSummary secret, string query) =>
        query.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).All(word =>
            secret.Name.Contains(word, StringComparison.OrdinalIgnoreCase)
            || (secret.Description?.Contains(word, StringComparison.OrdinalIgnoreCase) ?? false)
            || secret.Fields.Any(field => field.Key.Contains(word, StringComparison.OrdinalIgnoreCase) || field.Value.Contains(word, StringComparison.OrdinalIgnoreCase)));

    // Every keystroke asks again; only the answer to the last one is shown.
    private async Task Search()
    {
        var mine = ++asked;
        var text = query.Trim();
        if (!Everywhere)
        {
            await Show([], false);
            await OnFilter.InvokeAsync(text);
            return;
        }

        await OnFilter.InvokeAsync("");
        if (text.Length < SecretService.MinimumSearchLength)
        {
            await Show([], false);
            return;
        }

        IReadOnlyList<SecretSummary> result;
        try
        {
            result = await Vaults.Run(service => service.SearchAsync(text, Vaults.Caller, Limit));
        }
        catch (DomainException)
        {
            return;
        }

        if (mine == asked)
        {
            await Show(result, true);
        }
    }

    private async Task Show(IReadOnlyList<SecretSummary> result, bool shown)
    {
        found = result;
        if (searched != shown)
        {
            searched = shown;
            await OnSearching.InvokeAsync(shown);
        }
    }
}
