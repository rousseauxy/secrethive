@inject Vaults Vaults
@inject SearchState State
@inject NavigationManager Navigation
@implements IDisposable

@* The search for a secret, in the top bar of every page. On a vault's pages it narrows that vault's list by default
   (SearchState, read by the list), which reads nothing; across every vault it asks the server and shows the answers
   in a panel under the box, over the page, which closes on a choice, on Escape or on a click beside it. *@
<div class="sh-topsearch" role="search">
    <div class="sh-topsearch-box">
        <Icon Name="search" />
        <input type="search" placeholder="@Placeholder" autocomplete="off" spellcheck="false" aria-label="@Placeholder"
               @bind="query" @bind:event="oninput" @bind:after="Search" @onkeydown="Key" @onfocus="Reopen" />
        @if (vault is not null)
        {
            <select aria-label="Where to search" @bind="scope" @bind:after="Search">
                <option value="vault">This vault</option>
                <option value="all">All vaults</option>
            </select>
        }
    </div>

    @if (open)
    {
        <div class="sh-topsearch-backdrop" @onclick="Close"></div>
        <div class="sh-topsearch-panel" aria-label="Secrets found">
            @if (found.Count == 0)
            {
                <div class="sh-empty">Nothing in your vaults matches "@query". A search looks at names, descriptions and ordinary fields, never at values.</div>
            }
            else
            {
                @foreach (var secret in found)
                {
                    <a class="sh-topsearch-hit" href="@SecretHref(secret.Vault, secret.Name)" @onclick="Clear">
                        <span class="sh-mono sh-topsearch-name">@secret.Name</span>
                        <span class="sh-mono sh-muted sh-small">@secret.Vault</span>
                        @if (secret.Kind == ValueKind.Certificate)
                        {
                            <span class="sh-badge">certificate</span>
                        }
                        @if (!string.IsNullOrEmpty(secret.Description))
                        {
                            <span class="sh-muted sh-small sh-topsearch-desc">@secret.Description</span>
                        }
                    </a>
                }
                @if (found.Count == Limit)
                {
                    <div class="sh-muted sh-small sh-topsearch-more">The first @Limit are shown. Type more to narrow it down.</div>
                }
            }
        </div>
    }
</div>

@code {
    private const int Limit = 50;

    private IReadOnlyList<SecretSummary> found = [];
    private string query = "";
    private string scope = "vault";
    private bool open;
    private int asked;

    // The vault in the address (/vaults/{name} and every page under it), or null.
    private string? vault;

    private bool Everywhere => vault is null || scope == "all";

    private string Placeholder => Everywhere ? "Search every vault" : $"Search {vault}";

    private static string SecretHref(string vault, string secret) => $"/vaults/{vault}?secret={Uri.EscapeDataString(secret)}";

    protected override void OnInitialized()
    {
        vault = VaultIn(Navigation.Uri);
        Navigation.LocationChanged += Moved;
    }

    private static string? VaultIn(string uri)
    {
        var path = new Uri(uri).AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return path.Length >= 2 && path[0] == "vaults" ? Uri.UnescapeDataString(path[1]) : null;
    }

    // Another vault, or none: what was typed for the last one does not narrow this one.
    private void Moved(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        var now = VaultIn(e.Location);
        if (!string.Equals(now, vault, StringComparison.OrdinalIgnoreCase))
        {
            vault = now;
            (query, scope, open, found) = ("", "vault", false, []);
            State.Narrow("");
        }

        StateHasChanged();
    });

    /// <summary>Whether a secret holds every word of the query, by the same rules as the search across vaults.</summary>
    public static bool Matches(SecretSummary secret, string query) =>
        query.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).All(word =>
            secret.Name.Contains(word, StringComparison.OrdinalIgnoreCase)
            || (secret.Description?.Contains(word, StringComparison.OrdinalIgnoreCase) ?? false)
            || secret.Fields.Any(field => field.Key.Contains(word, StringComparison.OrdinalIgnoreCase) || field.Value.Contains(word, StringComparison.OrdinalIgnoreCase)));

    // Every keystroke asks again; only the answer to the last one is shown.
    private async Task Search()
    {
        var mine = ++asked;
        var text = query.Trim();
        if (!Everywhere)
        {
            (open, found) = (false, []);
            State.Narrow(text);

            // Narrowing a vault's list only means something on that list: from its other pages it goes there.
            if (text.Length > 0 && new Uri(Navigation.Uri).AbsolutePath != $"/vaults/{vault}")
            {
                Navigation.NavigateTo($"/vaults/{vault}");
            }

            return;
        }

        State.Narrow("");
        if (text.Length < SecretService.MinimumSearchLength)
        {
            (open, found) = (false, []);
            return;
        }

        IReadOnlyList<SecretSummary> result;
        try
        {
            result = await Vaults.Run(service => service.SearchAsync(text, Vaults.Caller, Limit));
        }
        catch (DomainException)
        {
            return;
        }

        if (mine == asked)
        {
            (found, open) = (result, true);
        }
    }

    private void Key(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            open = false;
        }
    }

    // Back in the box with answers still standing: show them again.
    private void Reopen()
    {
        if (Everywhere && query.Trim().Length >= SecretService.MinimumSearchLength)
        {
            open = true;
        }
    }

    private void Close() => open = false;

    // Following an answer leaves the search: the page it leads to is shown, not the answers.
    private void Clear()
    {
        (query, scope, open, found) = ("", "vault", false, []);
        State.Narrow("");
    }

    public void Dispose() => Navigation.LocationChanged -= Moved;
}
