@* The value of a secret and its sensitive fields, each hidden until revealed. A reveal or a copy is a read, on
   record like any other; Read does it, so the page that holds this decides what else follows a read. *@
<RevealBox @key="@($"value-{Secret.VersionId}")" Read="@(() => Read(SecretService.ValueSlot))" />
@foreach (var field in Secret.SensitiveFields)
{
    <div style="margin-top: 12px">
        <div class="sh-label sh-mono">@field</div>
        <RevealBox @key="@($"{field}-{Secret.VersionId}")" Read="@(() => Read($"field:{field}"))" />
    </div>
}

@code {
    [Parameter, EditorRequired]
    public SecretSummary Secret { get; set; } = default!;

    /// <summary>Reads a slot of the current version and gives it as text.</summary>
    [Parameter, EditorRequired]
    public Func<string, Task<string>> Read { get; set; } = default!;
}
