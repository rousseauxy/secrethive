@using System.Security.Cryptography

@* Makes a random value for the field above it: letters and digits, symbols if asked. The symbols are the ones that
   survive where values end up: no $ (compose and shells expand it), no quotes, backslash or backtick, no # (a comment
   in an .env file), no space. Made here, from the system's cryptographic generator; it is not on record, because
   nothing is stored until the form is saved. *@
<div class="sh-generate">
    <button type="button" class="sh-btn sh-btn-sm" @onclick="Generate"><Icon Name="refresh" /> Generate</button>
    <label class="sh-generate-length">
        <span>length</span>
        <input class="sh-input" type="number" min="@MinLength" max="@MaxLength" @bind="length" aria-label="Length of the generated value" />
    </label>
    <label class="sh-check"><input type="checkbox" @bind="symbols" /> symbols</label>
</div>

@code {
    public const int MinLength = 8;
    public const int MaxLength = 256;

    public const string Letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
    public const string Digits = "0123456789";
    public const string Symbols = "-_.!@^*+=:,";

    private int length = 32;
    private bool symbols = true;

    /// <summary>Gets the value that was made.</summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnGenerated { get; set; }

    private Task Generate() => OnGenerated.InvokeAsync(Make(Math.Clamp(length, MinLength, MaxLength), symbols));

    /// <summary>A value of that length with at least one letter and one digit, and one symbol when they are asked for.</summary>
    public static string Make(int length, bool withSymbols)
    {
        var alphabet = Letters + Digits + (withSymbols ? Symbols : "");
        while (true)
        {
            var value = RandomNumberGenerator.GetString(alphabet, length);
            if (value.AsSpan().IndexOfAny(Letters) >= 0 && value.AsSpan().IndexOfAny(Digits) >= 0 && (!withSymbols || value.AsSpan().IndexOfAny(Symbols) >= 0))
            {
                return value;
            }
        }
    }
}
