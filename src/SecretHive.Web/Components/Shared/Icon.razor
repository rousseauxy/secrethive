@* A small line icon that takes the colour of the text around it. Decoration only: the button that holds it says
   what it does in words (visible, or for a screen reader), so nothing depends on recognising a drawing. *@
<svg class="sh-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" />
            break;
        case "refresh":
            <path d="M20 11a8 8 0 1 0-2.3 6.3M20 4v7h-7" />
            break;
        case "eye":
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "eye-off":
            <path d="M3 3l18 18M10.6 5.2A9.6 9.6 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4M6.5 6.6A17 17 0 0 0 2 12s3.6 7 10 7a9.7 9.7 0 0 0 4.2-1M9.9 9.9a3 3 0 0 0 4.2 4.2" />
            break;
        case "copy":
            <rect x="9" y="9" width="11" height="11" rx="2" />
            <path d="M5 15V6a2 2 0 0 1 2-2h9" />
            break;
        case "check":
            <path d="M5 12.5l4.5 4.5L19 7.5" />
            break;
        case "restore":
            <path d="M4 12a8 8 0 1 1 2.3 5.7M4 19v-6h6" />
            break;
        case "left":
            <path d="M15 5l-7 7 7 7" />
            break;
        case "right":
            <path d="M9 5l7 7-7 7" />
            break;
        case "certificate":
            <circle cx="12" cy="9" r="5" />
            <path d="M9 13.5L8 21l4-2 4 2-1-7.5" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 7.5v.01" />
            break;
        case "open":
            <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
            break;
        case "star":
            <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
            break;
        case "star-on":
            <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="currentColor" />
            break;
        case "more":
            <circle cx="5" cy="12" r="1.2" />
            <circle cx="12" cy="12" r="1.2" />
            <circle cx="19" cy="12" r="1.2" />
            break;
        case "key":
            <circle cx="8" cy="15" r="4" />
            <path d="M11 12l9-9M16 7l3 3M14 9l2 2" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";
}
