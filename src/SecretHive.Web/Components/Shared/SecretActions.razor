@inject Vaults Vaults

@* The actions on one secret, each in a dialog: the same from the vault's list as from the secret's own page. The
   page that holds this decides which ones it offers (a new version takes Set, the others Secrets Officer); the
   server decides again. A refusal is said in the dialog, where it was asked, and the dialog stays open. *@
<Dialog Title="@TitleOf()" Open="@(action is not null)" OnClose="Close" Wide="@(action == SecretAction.NewVersion)">
    @if (secret is { } s)
    {
        <Problem Message="@problem" />
        @switch (action)
        {
            case SecretAction.NewVersion:
                @if (s.LinkedWith is { Count: > 0 })
                {
                    <div class="sh-note">A new version is the current version under every linked name: @string.Join(", ", s.LinkedWith).</div>
                }
                @if (s.Kind == ValueKind.Certificate)
                {
                    <form class="sh-form" @onsubmit="Renew">
                        <CertificateUpload @ref="upload" />
                        <div class="sh-form-actions">
                            <button class="sh-btn sh-btn-primary" type="submit">Store new version</button>
                            <button class="sh-btn" type="button" @onclick="Close">Cancel</button>
                        </div>
                    </form>
                }
                else
                {
                    <form class="sh-form" @onsubmit="NewVersion">
                        <div class="sh-field">
                            <label class="sh-label" for="new-value">New value</label>
                            <textarea id="new-value" class="sh-textarea" @bind="newValue" autocomplete="off" spellcheck="false"></textarea>
                            <PasswordGenerator OnGenerated="made => newValue = made" />
                        </div>
                        <div class="sh-field">
                            <label class="sh-label">Sensitive fields</label>
                            @foreach (var field in s.SensitiveFields)
                            {
                                <label class="sh-check"><input type="checkbox" checked="@keep.Contains(field)" @onchange="e => Keep(field, (bool)e.Value!)" /> keep <span class="sh-mono">@field</span> as it is</label>
                            }
                            <FieldEditor Rows="sensitive" />
                            <span class="sh-hint">Details and ordinary fields stay as they are.</span>
                        </div>
                        <div class="sh-form-actions">
                            <button class="sh-btn sh-btn-primary" type="submit">Set new version</button>
                            <button class="sh-btn" type="button" @onclick="Close">Cancel</button>
                        </div>
                    </form>
                }
                break;

            case SecretAction.Rename:
                <form class="sh-form" @onsubmit="Rename">
                    <div class="sh-note" style="margin: 0">
                        <b>Everything that names it stops finding it.</b> Its versions, fields, links and history stay with it.
                        Host manifests that read <span class="sh-mono">@Vault/@s.Name</span>, job settings and scripts must be changed
                        to the new name, and the hosts that read it then pull again.
                    </div>
                    <div class="sh-field">
                        <label class="sh-label" for="new-secret-name">New name</label>
                        <input id="new-secret-name" class="sh-input sh-mono" @bind="newName" placeholder="@s.Name" />
                        <span class="sh-hint">Letters, digits and hyphens, as for a new secret.</span>
                    </div>
                    <div class="sh-form-actions">
                        <button class="sh-btn sh-btn-primary" type="submit">Rename</button>
                        <button class="sh-btn" type="button" @onclick="Close">Cancel</button>
                    </div>
                </form>
                break;

            case SecretAction.Elsewhere:
                <form class="sh-form" @onsubmit:preventDefault>
                    @if (otherVaults.Count == 0)
                    {
                        <div class="sh-note" style="margin: 0">There is no other vault in which you are Secrets Officer or more, and nothing can be put anywhere else.</div>
                    }
                    else
                    {
                        <div class="sh-field">
                            <label class="sh-label">Vault</label>
                            <Picker Items="@([.. otherVaults.Select(vault => new Picker.Item(vault.Name, SecretService.RoleName(vault.Role), vault.Name))])" @bind-Value="targetVault" Placeholder="Search a vault…" />
                        </div>
                        <div class="sh-field">
                            <label class="sh-label" for="target-name">Name there</label>
                            <input id="target-name" class="sh-input sh-mono" placeholder="@s.Name" @bind="targetName" />
                            <span class="sh-hint">Left empty, it keeps its name.</span>
                        </div>
                    }
                    <div class="sh-form-actions">
                        @* Only what can be done there is offered: a link, a copy and a move all take Secrets Officer in the
                           other vault, and the vaults listed are only those. *@
                        <button type="button" class="sh-btn" disabled="@(TargetRole is null)" @onclick="Link">Link</button>
                        <button type="button" class="sh-btn" disabled="@(TargetRole is null)" @onclick="Copy">Copy</button>
                        <button type="button" class="sh-btn" disabled="@(TargetRole is null)" @onclick="Move">Move</button>
                        <button type="button" class="sh-btn" @onclick="Close">Cancel</button>
                    </div>
                    <span class="sh-hint">
                        <b>Link</b>: a second name for the same value; a rotation through either reaches both, and so does a change of its fields; the officers of either can change it. The new name starts with this description and keeps its own from then on.
                        <b>Copy</b>: an independent secret that will not follow a rotation; reading the source is recorded.
                        <b>Move</b>: this name and its history go there; manifests that name this vault must be changed.
                    </span>
                </form>
                break;

            case SecretAction.Unlink:
                <p style="margin-top: 0">
                    <span class="sh-mono">@Vault/@s.Name</span> stays here with a value of its own, a copy of the current one.
                    The other names keep the shared value: @(string.Join(", ", s.LinkedWith ?? []))@(s.LinkedElsewhere > 0 ? $"{(s.LinkedWith is { Count: > 0 } ? " and " : "")}{s.LinkedElsewhere} in vaults you cannot see" : "").
                    A rotation through one of them no longer reaches this one.
                </p>
                <div class="sh-form-actions">
                    <button type="button" class="sh-btn sh-btn-primary" @onclick="Unlink">Unlink this name</button>
                    <button type="button" class="sh-btn" @onclick="Close">Cancel</button>
                </div>
                break;

            case SecretAction.Delete:
                <p style="margin-top: 0">
                    A delete moves <span class="sh-mono">@Vault/@s.Name</span> to the bin of this vault. Nothing is destroyed, and it can be restored.
                    @if (s.IsLinked)
                    {
                        <span>Only this name goes; the other names keep the value.</span>
                    }
                </p>
                @if (!confirmingEverywhere)
                {
                    <div class="sh-form-actions">
                        <button type="button" class="sh-btn sh-btn-danger" @onclick="Delete">@(s.IsLinked ? "Delete this name only" : "Delete")</button>
                        @if (s.LinkedWith is { Count: > 0 } && s.LinkedElsewhere == 0)
                        {
                            <button type="button" class="sh-btn sh-btn-danger" @onclick="() => confirmingEverywhere = true">Delete everywhere…</button>
                        }
                        <button type="button" class="sh-btn" @onclick="Close">Cancel</button>
                    </div>
                }
                else if (s.LinkedWith is { Count: > 0 } linked)
                {
                    <div class="sh-alert" role="alertdialog">
                        <b>This removes the secret from every vault it is in: @(linked.Count + 1) names.</b>
                        <ul class="sh-list sh-mono">
                            <li>@Vault/@s.Name</li>
                            @foreach (var other in linked)
                            {
                                <li>@other</li>
                            }
                        </ul>
                        Each goes to the bin of its own vault.
                        <div class="sh-form-actions" style="margin-top: 10px">
                            <button type="button" class="sh-btn sh-btn-danger" @onclick="DeleteEverywhere">Delete from all @(linked.Count + 1) vaults</button>
                            <button type="button" class="sh-btn" @onclick="() => confirmingEverywhere = false">Back</button>
                        </div>
                    </div>
                }
                break;
        }
    }
</Dialog>

@code {
    private SecretAction? action;
    private SecretSummary? secret;
    private string? problem;

    private string newValue = "";
    private List<FieldRow> sensitive = [];
    private HashSet<string> keep = [];
    private CertificateUpload upload = default!;

    private string newName = "";

    // The other vaults in which this caller may at least change secrets: nothing can be put anywhere else.
    private IReadOnlyList<(string Name, VaultRole Role)> otherVaults = [];
    private string targetVault = "";
    private string? targetName;

    private bool confirmingEverywhere;

    private VaultRole? TargetRole => otherVaults.Where(vault => vault.Name == targetVault).Select(vault => (VaultRole?)vault.Role).FirstOrDefault();

    [Parameter, EditorRequired]
    public string Vault { get; set; } = "";

    /// <summary>Said when an action was done; the dialog is closed by then.</summary>
    [Parameter]
    public EventCallback<SecretActionResult> OnDone { get; set; }

    /// <summary>Opens the dialog for one action on one secret, with nothing left from an earlier one.</summary>
    public async Task Open(SecretAction what, SecretSummary on)
    {
        (secret, problem, confirmingEverywhere) = (on, null, false);
        (newValue, sensitive, keep) = ("", [], [.. on.SensitiveFields]);
        newName = "";
        (targetVault, targetName) = ("", null);
        if (what == SecretAction.Elsewhere)
        {
            otherVaults = await OtherVaults();
        }

        action = what;
        StateHasChanged();
    }

    private async Task<IReadOnlyList<(string, VaultRole)>> OtherVaults()
    {
        var others = new List<(string, VaultRole)>();
        try
        {
            foreach (var other in (await Vaults.Run(service => service.ListVaultsAsync(Vaults.Caller))).Where(vault => !string.Equals(vault.Name, Vault, StringComparison.OrdinalIgnoreCase)))
            {
                if (await Vaults.Run(service => service.RoleAsync(other.Name, Vaults.Caller)) is { } there && there >= VaultRole.SecretsOfficer)
                {
                    others.Add((other.Name, there));
                }
            }
        }
        catch (DomainException e)
        {
            problem = e.Message;
        }

        return others;
    }

    private string TitleOf() => action switch
    {
        SecretAction.NewVersion when secret?.Kind == ValueKind.Certificate => $"Renew {secret.Name}",
        SecretAction.NewVersion => $"New version of {secret?.Name}",
        SecretAction.Rename => $"Rename {secret?.Name}",
        SecretAction.Elsewhere => $"Link, copy or move {secret?.Name}",
        SecretAction.Unlink => $"Unlink {secret?.Name}",
        SecretAction.Delete => $"Delete {secret?.Name}",
        _ => "",
    };

    private void Close()
    {
        // What was typed does not stay behind: a value is not kept in a closed form.
        (action, newValue, sensitive, problem) = (null, "", [], null);
    }

    private void Keep(string field, bool on)
    {
        if (on)
        {
            keep.Add(field);
        }
        else
        {
            keep.Remove(field);
        }
    }

    private async Task Do(Func<SecretService, Task> act, string message, string? location = null)
    {
        problem = await Vaults.Try(act);
        if (problem is null)
        {
            Close();
            await OnDone.InvokeAsync(new SecretActionResult(message, location));
        }
    }

    private string Name => secret!.Name;

    private Task NewVersion() => Do(
        service => service.SetAsync(
            new SetSecret(
                Vault,
                Name,
                Encoding.UTF8.GetBytes(newValue),
                secret!.ContentType,
                Fields: [.. sensitive.Select(row => { row.Sensitive = true; return row.ToInput(); })],
                KeepDetails: true,
                KeepSensitiveFields: [.. keep]),
            Vaults.Caller),
        $"New version of {Name} set.");

    private Task Renew() => Do(
        service => service.ImportCertificateAsync(new ImportCertificate(Vault, Name, upload.Parts(), secret!.Description), Vaults.Caller),
        $"New version of {Name} stored.");

    private Task Rename()
    {
        var to = newName.Trim();
        return Do(service => service.RenameSecretAsync(Vault, Name, to, Vaults.Caller), $"Renamed {Name} to {to}.", $"/vaults/{Vault}/secrets/{to}");
    }

    private string Where => $"{targetVault}/{(string.IsNullOrWhiteSpace(targetName) ? Name : targetName.Trim())}";

    private Task Link() => Do(service => service.LinkAsync(Vault, Name, targetVault, targetName, Vaults.Caller), $"Linked {Name} as {Where}.");

    private Task Copy() => Do(service => service.CopyAsync(Vault, Name, targetVault, targetName, Vaults.Caller), $"Copied {Name} to {Where}.");

    private Task Move()
    {
        var where = Where;
        return Do(service => service.MoveAsync(Vault, Name, targetVault, targetName, Vaults.Caller), $"Moved {Name} to {where}.", $"/vaults/{where.Replace("/", "/secrets/", StringComparison.Ordinal)}");
    }

    private Task Unlink() => Do(service => service.UnlinkAsync(Vault, Name, Vaults.Caller), $"Unlinked {Name}: it has a value of its own now.");

    private Task Delete() => Do(service => service.DeleteAsync(Vault, Name, Vaults.Caller), $"{Name} is in the bin.", $"/vaults/{Vault}");

    // What the dialog listed is what is sent: if a name was linked or unlinked since, nothing is deleted.
    private Task DeleteEverywhere()
    {
        string[] names = [$"{Vault}/{Name}", .. secret!.LinkedWith!];
        return Do(service => service.DeleteEverywhereAsync(Vault, Name, names, Vaults.Caller), $"{Name} is in the bin of all {names.Length} vaults.", $"/vaults/{Vault}");
    }
}
