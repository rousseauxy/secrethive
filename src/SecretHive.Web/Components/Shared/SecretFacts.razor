@* What can be known about a secret without reading it: its description, ordinary fields (username and url with a
   copy button, which is no read), its version, where it was copied from and the names it is linked under. *@
<dl class="sh-facts">
    <dt>Description</dt><dd>@(Secret.Description ?? "—")</dd>
    @foreach (var field in Secret.Fields)
    {
        <dt class="sh-mono">@field.Key</dt>
        <dd>
            @field.Value
            @if (field.Key is "username" or "url")
            {
                <CopyButton Title="@($"Copy the {field.Key}")" Text="@(() => Task.FromResult<string?>(field.Value))" />
            }
        </dd>
    }
    <dt>Version</dt><dd>@Secret.Version, set @Secret.VersionCreatedUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</dd>
    @if (Secret.CopiedFrom is not null)
    {
        <dt>Copied from</dt><dd class="sh-mono">@Secret.CopiedFrom</dd>
    }
    @if (Secret.IsLinked)
    {
        <dt>Linked with</dt>
        <dd class="sh-mono">
            @string.Join(", ", Secret.LinkedWith ?? [])
            @if (Secret.LinkedElsewhere > 0)
            {
                <span class="sh-muted">@(Secret.LinkedWith is { Count: > 0 } ? "and " : "")@Secret.LinkedElsewhere in vaults you cannot see</span>
            }
        </dd>
    }
</dl>

@code {
    [Parameter, EditorRequired]
    public SecretSummary Secret { get; set; } = default!;
}
