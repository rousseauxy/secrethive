<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Lifted out of CVE-2026-84008 and CVE-2026-70162 (denial of service, patched in 10.0.13). The SQL client asks for
         9.0.11, and the runtime of the server image carries its own copy, so a runtime older than 10.0.13 would load the
         open one: this reference ships the patched assembly with the application, whatever the image. Remove it once
         the SQL client and the image both bring 10.0.13 or later. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SecretHive.Infrastructure\SecretHive.Infrastructure.csproj" />
  </ItemGroup>
</Project>
