<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA2201;CA1861;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <!-- Each layer explicitly, not transitively: the boundary test loads every assembly by name. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\SecretHive.Cli\SecretHive.Cli.csproj" />
    <ProjectReference Include="..\..\src\SecretHive.Domain\SecretHive.Domain.csproj" />
    <ProjectReference Include="..\..\src\SecretHive.Application\SecretHive.Application.csproj" />
    <ProjectReference Include="..\..\src\SecretHive.Infrastructure\SecretHive.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SecretHive.Infrastructure.Sqlite\SecretHive.Infrastructure.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\SecretHive.Infrastructure.SqlServer\SecretHive.Infrastructure.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\SecretHive.Api\SecretHive.Api.csproj" />
    <ProjectReference Include="..\..\src\SecretHive.Web\SecretHive.Web.csproj" />
  </ItemGroup>
</Project>
