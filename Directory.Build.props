<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>Xact Solutions</Company>
    <Product>SecretHive</Product>
    <Copyright>Copyright (c) 2026 Xact Solutions</Copyright>
    <!-- Same exceptions as the sibling applications.
         CA1515: public types in an application are fine; the test project needs them.
         CA1062: nullable reference types already cover argument null checks. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1515;CA1062;CA1716;CA1711;CA1720;CA1859</NoWarn>
  </PropertyGroup>
</Project>
